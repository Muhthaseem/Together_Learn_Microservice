{
  "info": {
    "name": "TogetherLearn API",
    "_postman_id": "tl-microservices-v1",
    "description": "Complete API test suite for TogetherLearn microservices via the API Gateway (port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "groupId", "value": "" },
    { "key": "questionId", "value": "" },
    { "key": "answerId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "offerId", "value": "" }
  ],
  "item": [
    {
      "name": "1 – Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has token', () => pm.expect(r.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', r.token);",
                  "pm.collectionVariables.set('userId', r.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"en202001@foe.sjp.ac.lk\",\n  \"password\": \"password123\",\n  \"department\": \"CO\",\n  \"batch\": \"Batch 5\",\n  \"registrationNumber\": \"EN202001\",\n  \"indexNumber\": \"20/ENG/001\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has token', () => pm.expect(r.token).to.be.a('string'));",
                  "pm.test('Has userId', () => pm.expect(r.userId).to.be.a('string'));",
                  "pm.collectionVariables.set('token', r.token);",
                  "pm.collectionVariables.set('userId', r.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"en202001@foe.sjp.ac.lk\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2 – Meta & Courses",
      "item": [
        {
          "name": "Get Departments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base}}/meta/departments"
          }
        },
        {
          "name": "Get Batches",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base}}/meta/batches"
          }
        },
        {
          "name": "List Courses (all)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "const courses = pm.response.json();",
                  "pm.test('Has courses', () => pm.expect(courses.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base}}/courses"
          }
        },
        {
          "name": "List Courses by Department",
          "request": {
            "method": "GET",
            "url": "{{base}}/courses?department=CO"
          }
        },
        {
          "name": "Search Courses",
          "request": {
            "method": "GET",
            "url": "{{base}}/courses?q=data"
          }
        }
      ]
    },
    {
      "name": "3 – Groups",
      "item": [
        {
          "name": "Create Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('Has groupId', () => pm.expect(r.groupId).to.be.a('string'));",
                  "pm.collectionVariables.set('groupId', r.groupId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base}}/groups",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"CO3040 Study Session\",\n  \"description\": \"Weekly revision of distributed systems concepts\",\n  \"courseCode\": \"CO3040\",\n  \"scheduledDate\": \"2026-05-20\",\n  \"scheduledTime\": \"14:00:00\",\n  \"location\": \"Library Room 3\",\n  \"mode\": \"PHYSICAL\",\n  \"maxParticipants\": 10\n}"
            }
          }
        },
        {
          "name": "List Groups",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base}}/groups",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Group Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has groupId', () => pm.expect(pm.response.json().groupId).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base}}/groups/{{groupId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Join Group (second user – update token first)",
          "request": {
            "method": "POST",
            "url": "{{base}}/groups/{{groupId}}/join",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Leave Group",
          "request": {
            "method": "POST",
            "url": "{{base}}/groups/{{groupId}}/leave",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Post Chat Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has messageId', () => pm.expect(pm.response.json().messageId).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base}}/messages/groups/{{groupId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello group! Ready for today's session?\"\n}"
            }
          }
        },
        {
          "name": "List Chat Messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has content array', () => pm.expect(pm.response.json().content).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base}}/messages/groups/{{groupId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "4 – Q&A",
      "item": [
        {
          "name": "Create Question",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
