                  "pm.collectionVariables.set('questionId', r.questionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base}}/questions",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"What is the CAP theorem?\",\n  \"body\": \"Can someone explain Consistency, Availability, and Partition Tolerance in distributed systems?\",\n  \"courseCode\": \"CO3040\",\n  \"tags\": \"distributed-systems,cap-theorem\"\n}"
            }
          }
        },
        {
          "name": "List Questions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base}}/questions",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Question Detail",
          "request": {
            "method": "GET",
            "url": "{{base}}/questions/{{questionId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Add Answer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('Has answerId', () => pm.expect(r.answerId).to.be.a('string'));",
                  "pm.collectionVariables.set('answerId', r.answerId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base}}/questions/{{questionId}}/answers",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"The CAP theorem states that a distributed system can only guarantee two of the three: Consistency, Availability, and Partition Tolerance.\"\n}"
            }
          }
        },
        {
          "name": "Accept Answer",
          "request": {
            "method": "POST",
            "url": "{{base}}/questions/{{questionId}}/answers/{{answerId}}/accept",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "List Questions by Course",
          "request": {
            "method": "GET",
            "url": "{{base}}/questions?courseCode=CO3040",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
